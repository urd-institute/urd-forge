{
  "name": "urd-forge",
  "version": "1.1.3",
  "description": "URD Forge — the open web interface for spec-driven AI development. Reads, visualises and searches spec-driven project files; the files are the database.",
  "author": "URD Institute (https://urdinstitute.org)",
  "homepage": "https://github.com/urd-institute/urd-forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/urd-institute/urd-forge.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "forge": "node scripts/forge.js",
    "start": "node scripts/forge.js",
    "build": "node scripts/forge.js --build-only",
    "dev": "node scripts/forge.js --dev"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}

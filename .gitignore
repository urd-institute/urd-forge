node_modules/
app/client/dist/
.forge/
*.log
.DS_Store
Thumbs.db
# Internal Forge-format project documents — dev planning, not part of the
# published repo (root-anchored so example projects are unaffected)
_doc/
/CLAUDE.md
/ROADMAP.md
/CONCEPT.md
/DOCS.md
/DESIGN.md
/specs/
/agents/

# Users' own projects stay local — only the template and the demo ship.
/projects/*
!/projects/.gitkeep
!/projects/_template/
!/projects/demo-kaffelog/
# Standard agents are installed into the demo by Forge at runtime (SPEC-04);
# keeping them out of the repo means an update can never collide with them.
/projects/demo-kaffelog/agents/

# Local configuration stays local — copy forge.config.example.yaml to start.
/forge.config.yaml
# Local installation state written by Forge (e.g. archived projects).
/forge.state.json

# Claude Code session data
.claude/
